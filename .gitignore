__pycache__/

# ---- Personal data: stays on each person's machine, never pushed ----
# Everyone customizes their own folders freely without touching anyone else's.
# The shared tool (skills, agents, scripts, template, READMEs) is all that the repo holds.

# who is using this checkout (one line: your slug)
.me

# your profile, resume, accomplishments, answers (only the template and README are shared)
skillsets-and-contributions/*/
!skillsets-and-contributions/_template/

# your results: job applications, LinkedIn ledgers, product outreach, Upwork files
apply/*/
linkedin/*/
!linkedin/scripts/
product-outreach/*/
upwork/*/

# personal Claude Code settings and notes
.claude/settings.local.json
CLAUDE.local.md

# local Python packages (pip install -r requirements.txt into .venv)
.venv/
